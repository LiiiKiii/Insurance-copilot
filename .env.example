# Insurance Performance Intelligence Copilot
# A4 Runtime Configuration

# LLM provider
NANOBOT_AGENTS__DEFAULTS__PROVIDER=openrouter
NANOBOT_AGENTS__DEFAULTS__MODEL=openai/gpt-4o-mini

# OpenRouter credentials
NANOBOT_PROVIDERS__OPENROUTER__API_KEY=
# Embedding and speech services use the provider-compatible environment key.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_ASR_MODEL=qwen/qwen3-asr-0.6b
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_EMBEDDING_DIMENSIONS=1536
# OPENROUTER_EMBEDDING_BATCH_SIZE=32

# Knowledge ingestion and retrieval
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=50
# RAG_VECTOR_TOP_K=5
# RAG_VECTOR_DISTANCE_THRESHOLD=0.55
# BUILTIN_KNOWLEDGE_AUTO_SYNC=1

# Browser origins allowed to open the authenticated chat WebSocket.
WS_ALLOWED_ORIGINS=http://localhost:3000

# Optional agent generation settings
# NANOBOT_AGENTS__DEFAULTS__MAX_TOKENS=8192
# NANOBOT_AGENTS__DEFAULTS__TEMPERATURE=0.1

# Optional administrative database settings
# Defaults to data/db/admin.db when ADMIN_DATABASE_URL is not set.
# ADMIN_DATABASE_URL=sqlite+aiosqlite:///data/db/admin.db
# ADMIN_DB_ECHO=0

# Isolated M1 coursework demo only. Migrate and run admin.seeds in data/demo/m1_coursework.db.
# Never point the setup command at the default, shared, or production database.
# ADMIN_DATABASE_URL=sqlite+aiosqlite:///E:/path/to/Insurance-copilot/data/demo/m1_coursework.db
# Set both to the IDs printed by scripts.setup_m1_coursework_demo after seed validation.
# M1_COURSEWORK_DEMO_TENANT_ID=
# M1_COURSEWORK_DEMO_AGENT_ID=

# A4 admin authentication
# Generate a random value of at least 32 UTF-8 bytes. Never commit the real secret.
ADMIN_SECRET_KEY=
# Used only when `python -m admin.seeds` creates the initial admin account.
ADMIN_DEFAULT_PASSWORD=
# Used only when `python -m admin.seeds` creates the mock agent accounts (AGT001 etc.).
AGENT_DEFAULT_PASSWORD=
# Optional token lifetimes
# ADMIN_ACCESS_TOKEN_MINUTES=15
# ADMIN_REFRESH_TOKEN_DAYS=7
